<?xml version="1.0" encoding="UTF-8"?>
<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <properties>
        <property id="left_metric" type="number">0</property>
        <property id="center_metric" type="number">1</property>
        <property id="right_metric" type="number">3</property>
    </properties>
    <settings>
        <setting propertyKey="@Properties.left_metric" title="@Strings.left_metric_title">
            <settingConfig type="list">
                <listEntry value="0">@Strings.metric_heart_rate</listEntry>
                <listEntry value="1">@Strings.metric_battery</listEntry>
                <listEntry value="2">@Strings.metric_steps</listEntry>
                <listEntry value="3">@Strings.metric_stress</listEntry>
            </settingConfig>
        </setting>
        <setting propertyKey="@Properties.center_metric" title="@Strings.center_metric_title">
            <settingConfig type="list">
                <listEntry value="0">@Strings.metric_heart_rate</listEntry>
                <listEntry value="1">@Strings.metric_battery</listEntry>
                <listEntry value="2">@Strings.metric_steps</listEntry>
                <listEntry value="3">@Strings.metric_stress</listEntry>
            </settingConfig>
        </setting>
        <setting propertyKey="@Properties.right_metric" title="@Strings.right_metric_title">
            <settingConfig type="list">
                <listEntry value="0">@Strings.metric_heart_rate</listEntry>
                <listEntry value="1">@Strings.metric_battery</listEntry>
                <listEntry value="2">@Strings.metric_steps</listEntry>
                <listEntry value="3">@Strings.metric_stress</listEntry>
            </settingConfig>
        </setting>
    </settings>
</resources>
